# ── Backend ──────────────────────────────────────────
PORT=3001
NODE_ENV=development

# Database (PostgreSQL) - Can use full URL or individual DB_* credentials
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_NAME=english_app
DB_USER=postgres
DB_PASS=yourpassword
DB_SSL=false

# AI Provider — Gemini
GEMINI_API_KEY=AI...
GEMINI_MODEL=gemini-1.5-pro

# CORS
FRONTEND_URL=http://localhost:5173
